BASE_URL=https://staging-th-web.ca.rbi.tools/
# Site protection password (do not commit real value; set in .env only)
SITE_PASSWORD=

# Store used for location/store selection tests (e.g. storeSelection).
TEST_STORE_ADDRESS=1500 Woodbine Ave
TEST_STORE_NAME=1500 woodbine ave

# Default existing account used when TEST_USER_EMAILS is not provided.
TEST_USER_EMAIL=timregression+95@gmail.com

# Optional comma-separated account pool for parallel runs.
# Example:
# TEST_USER_EMAILS=qa.user1@gmail.com,qa.user2@gmail.com,qa.user3@gmail.com
TEST_USER_EMAILS=

TEST_OTP=
TEST_BAD_OTP=000000
NON_EXISTING_USER_EMAIL=timregression+9595@gmail.com

# Expected cart item total — TC-000.1 Brewed Coffee (Item Total line). Update when pricing changes.
TEST_EXPECTED_ITEM_TOTAL_BREWED_COFFEE=13.96

# Expected cart item total — TC-000.2 Boston Cream Donut (Item Total line). Update when pricing changes.
TEST_EXPECTED_ITEM_TOTAL_BOSTON_CREAM_DONUT=11.83
TEST_EXPECTED_ITEM_TOTAL_BLACK_COLD_BREW=16.95
# TC-000.4 — matches cart Item Total after qty/checkout steps (update if store pricing differs).
TEST_EXPECTED_ITEM_TOTAL_CLASSIC_BREAKFAST_WRAPS=34.93
